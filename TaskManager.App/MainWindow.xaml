<Window x:Class="TaskManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de tareas"
        Height="400"
        Width="550"
        AutomationProperties.AutomationId="MainWindow">

    <StackPanel Margin="24">

        <TextBlock Text="Nueva tarea"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="TaskTitleInput"
                 AutomationProperties.AutomationId="TaskTitleInput"
                 AutomationProperties.Name="Título de la tarea"
                 Height="30"
                 Margin="0,0,0,12"/>

        <Button Content="Agregar"
                AutomationProperties.AutomationId="AddTaskButton"
                Height="32"
                Click="AddTask_Click"/>

        <TextBlock x:Name="StatusMessage"
                   AutomationProperties.AutomationId="StatusMessage"
                   Text="Sin tareas"
                   Margin="0,12,0,12"/>

        <ListBox x:Name="TaskList"
                 AutomationProperties.AutomationId="TaskList"
                 Height="180"/>

    </StackPanel>
</Window>